# Copy this to ".env" (same folder as docker-compose.yml) and fill in your domain.
#
# Your public domain, served behind Cloudflare. Used for:
#   - the browser → backend connection (NEXT_PUBLIC_SERVER_URL)
#   - backend CORS allowlist (CLIENT_ORIGIN)
#
# Local dev: leave unset (defaults to localhost).
# Production example:
# PUBLIC_URL=https://dj.yourdomain.com

PUBLIC_URL=
