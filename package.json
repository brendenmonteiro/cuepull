{
  "name": "cuepull",
  "version": "1.1.0",
  "private": true,
  "description": "Cuepull, a desktop track downloader for building a DJ library",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brendenmonteiro/cuepull.git"
  },
  "homepage": "https://github.com/brendenmonteiro/cuepull#readme",
  "bugs": {
    "url": "https://github.com/brendenmonteiro/cuepull/issues"
  },
  "main": "electron/main.js",
  "scripts": {
    "build:ui": "node scripts/build-ui.js",
    "start": "electron electron",
    "start:debug": "electron electron --debug",
    "pack": "npm run fetch:bin && npm run build:ui && electron-builder --dir",
    "dist": "npm run fetch:bin && npm run build:ui && electron-builder && npm run checksums",
    "fetch:bin": "node scripts/fetch-binaries.js",
    "checksums": "node scripts/checksums.js"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.brend.cuepull",
    "productName": "Cuepull",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "client/out/**/*",
      "!server/.env",
      "!server/.env.example",
      "!server/.ssl/**",
      "!server/downloads/**",
      "!**/node_modules/nodemon/**",
      "!**/node_modules/.bin/**",
      "!**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "server/**/*",
      "client/out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "signtoolOptions": {
        "publisherName": "Brenden Monteiro",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cuepull"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "resources/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Cuepull"
    }
  },
  "license": "MIT",
  "author": "Brenden Monteiro"
}
