# dependencies
node_modules/
**/node_modules/

# builds
client/.next/
client/out/

# env & secrets, never commit these
.env
**/.env
**/.env.local
server/.spotify-tokens.json
server/.ssl/

# downloaded audio
server/downloads/
downloads/
!server/downloads/.gitkeep

# logs / os
*.log
.DS_Store

# desktop app
dist/
client/out/
resources/bin/
node_modules/

# build artifacts
*.tsbuildinfo

# bundled binaries are fetched by scripts/fetch-binaries.js, not committed
# (resources/bin/ is ignored above; resources/icon.ico IS committed)
!resources/icon.ico

# local library stats store
server/.data/
