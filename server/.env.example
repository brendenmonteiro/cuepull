# server/.env
# Copy this file to .env and fill in your values

PORT=3001
CLIENT_ORIGIN=http://localhost:3000

# Spotify Web API, required for playlist/album/track lookups
# Get these at https://developer.spotify.com/dashboard → Create App
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Where finished tracks are saved. Files are filed into a per-day subfolder
# (DD-MM-YYYY), e.g. <DOWNLOADS_DIR>/27-09-2026/Artist - Song.mp3
# Leave unset to use server/downloads.
# DOWNLOADS_DIR=C:/Users/you/Music/DJ Core
